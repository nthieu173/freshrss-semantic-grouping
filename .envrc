# shellcheck shell=bash
# Tools missing from the host, from manifest.scm, built with your Guix and
# cached in .direnv (`use guix_manifest`, from Guix Home's direnv lib).
use guix_manifest manifest.scm

# prek, codespell and rumdl from pyproject.toml, at the versions in uv.lock.
watch_file pyproject.toml uv.lock
uv sync --locked --quiet || return
PATH_add .venv/bin

# The worker's dev tools (pytest, ruff, mypy) from worker/pyproject.toml, at
# the versions in worker/uv.lock. VIRTUAL_ENV names this one, so the
# Makefile's `cd worker && uv run` uses it without a mismatch warning.
watch_file worker/pyproject.toml worker/uv.lock
uv sync --project worker --locked --extra dev --quiet || return
export VIRTUAL_ENV="${PWD}/worker/.venv"
PATH_add worker/.venv/bin

# Your own settings, gitignored.
source_env_if_exists .envrc.local
