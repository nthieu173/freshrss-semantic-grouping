ARG PYTHON_IMAGE=python:3.14.7-slim-trixie
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.10

FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE}

ARG VERSION=0.13.0
ARG REVISION=unknown
ARG SOURCE=https://github.com/example/freshrss-semantic-grouping
ARG MODEL_REVISION=bf8b056651a2c21b8d2565580b8569da283cab23

LABEL org.opencontainers.image.title="FreshRSS semantic grouping worker" \
      org.opencontainers.image.description="Offline Model2Vec and SemHash worker for FreshRSS" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      io.freshrss.semantic.model.revision="${MODEL_REVISION}"

ENV PATH="/app/worker/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HOME=/tmp/huggingface \
    XDG_CACHE_HOME=/tmp/.cache \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY README.md /app/README.md
COPY worker/pyproject.toml worker/uv.lock worker/README.md /app/worker/
RUN uv sync --project /app/worker --locked --no-dev --no-install-project \
	&& uv cache clean \
	&& mkdir -p /opt/models \
	&& MODEL_REVISION="${MODEL_REVISION}" python -c 'import os; from huggingface_hub import snapshot_download; from model2vec import StaticModel; source = snapshot_download("minishlab/potion-base-8M", revision=os.environ["MODEL_REVISION"], allow_patterns=["README.md", "config.json", "model.safetensors", "modules.json", "tokenizer.json"]); StaticModel.from_pretrained(source).save_pretrained("/opt/models/potion-base-8M")' \
	&& chmod -R a+rX /opt/models/potion-base-8M \
	&& rm -rf /tmp/huggingface /tmp/.cache
COPY worker/src /app/worker/src
RUN uv sync --project /app/worker --locked --no-dev --no-editable \
    && uv cache clean \
    && useradd --uid 10001 --gid 33 --home-dir /nonexistent --no-create-home --shell /usr/sbin/nologin semantic-worker

USER 10001:33
WORKDIR /semantic-data
ENTRYPOINT ["freshrss-semantic"]
CMD ["run"]
