	<div class="form-group">
		<label class="group-name" for="similarity-threshold">Similarity threshold</label>
		<div class="group-controls"><input id="similarity-threshold" type="number" min="0" max="1" step="0.01" name="similarity_threshold" value="<?= $escaped($config['similarity_threshold']) ?>" required="required" /></div>
	</div>

	<div class="form-group">
		<label class="group-name" for="window-hours">Rolling window (hours)</label>
		<div class="group-controls"><input id="window-hours" type="number" min="1" max="8760" name="window_hours" value="<?= (int)$config['window_hours'] ?>" required="required" /></div>
	</div>

	<div class="form-group">
		<label class="group-name">Embedding input</label>
		<div class="group-controls">
			<label><input type="checkbox" name="include_title" value="1"<?= $checked(!empty($config['include_title'])) ?> /> Title</label><br />
			<label><input type="checkbox" name="include_content" value="1"<?= $checked(!empty($config['include_content'])) ?> /> Content</label><br />
			<label for="content-limit">Content character limit</label>
