	<div class="form-group">
		<label class="group-name" for="embedding-model">Embedding model</label>
		<div class="group-controls"><input class="w100" id="embedding-model" name="embedding_model" value="<?= $escaped($config['embedding_model']) ?>" required="required" /></div>
