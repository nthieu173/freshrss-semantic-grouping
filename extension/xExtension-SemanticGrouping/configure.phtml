<?php
declare(strict_types=1);
/** @var SemanticGroupingExtension $this */
$config = $this->configuration;
$source = is_array($config['candidate_source'] ?? null) ? $config['candidate_source'] : [];
$selectedSource = ($source['mode'] ?? '') === 'all_entries' ? 'all_entries' : (string)($source['query_id'] ?? '');
$checked = static fn(bool $value): string => $value ? ' checked="checked"' : '';
$escaped = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$formatTime = static function (mixed $value): string {
	$timestamp = (int)$value;
	return $timestamp > 0 ? date('Y-m-d H:i:s T', $timestamp) : 'Never';
};
?>

<?php if ($this->notice !== ''): ?>
	<p class="alert alert-success"><?= $escaped($this->notice) ?></p>
<?php endif; ?>
<?php foreach ($this->configurationErrors as $error): ?>
	<p class="alert alert-error"><?= $escaped($error) ?></p>
<?php endforeach; ?>

<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post" data-auto-leave-validation="1">
	<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
	<input type="hidden" name="force_rebuild_token" value="<?= $escaped($config['force_rebuild_token'] ?? '') ?>" />

	<div class="form-group">
		<label class="group-name" for="semantic-enabled">Pipeline</label>
		<div class="group-controls">
			<label><input id="semantic-enabled" type="checkbox" name="enabled" value="1"<?= $checked(!empty($config['enabled'])) ?> /> Enable exports and worker processing</label>
