		<div class="form-group form-actions"><div class="group-controls">
			<button type="submit" class="btn btn-attention confirm">Full semantic database reset</button>
			<p class="help">The reset runs only while the worker lock is available and immediately republishes candidates.</p>
		</div></div>
	</form>
<?php endif; ?>
