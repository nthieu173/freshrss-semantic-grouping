	<div class="form-group">
		<label class="group-name">Refresh and processing</label>
		<div class="group-controls">
			<div class="semantic-grid">
				<label>Refresh interval (minutes) <input type="number" min="10" max="1440" step="10" name="candidate_export_interval_minutes" value="<?= (int)$config['candidate_export_interval_minutes'] ?>" required="required" /></label>
				<label>Embedding batch size <input type="number" min="1" max="256" name="embedding_batch_size" value="<?= (int)$config['embedding_batch_size'] ?>" required="required" /></label>
