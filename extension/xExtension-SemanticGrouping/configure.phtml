<h3>Pipeline status</h3>
<?php $status = $this->semanticStatus; ?>
<?php if (empty($status['available'])): ?>
	<p class="alert alert-warn">Semantic storage is unavailable. Normal FreshRSS operation is unaffected.</p>
<?php elseif (empty($status['configured'])): ?>
	<p class="alert alert-warn">No candidate generation has been published yet.</p>
<?php else: ?>
	<?php
	$pipeline = $status['pipeline'];
	$worker = $status['worker'];
	$export = $status['export'];
	$labelSync = $status['label_sync'];
	$effective = $status['config'];
	$workerError = trim((string)($worker['latest_error'] ?? ''));
	$exportError = trim((string)($export['last_export_error'] ?? ''));
	$labelError = trim((string)($labelSync['latest_error'] ?? ''));
	$errorCandidates = [];
	foreach ([
		[(int)($worker['latest_error_at'] ?? 0), $workerError],
		[(int)($export['last_export_error_at'] ?? 0), $exportError],
		[(int)($labelSync['latest_error_at'] ?? 0), $labelError],
	] as [$errorTime, $errorText]) {
		if ($errorText !== '') {
			$errorCandidates[] = [$errorTime, $errorText];
		}
	}
	usort($errorCandidates, static fn(array $left, array $right): int => $right[0] <=> $left[0]);
	$latestError = (string)($errorCandidates[0][1] ?? '');
	?>
	<dl class="semantic-status">
		<dt>Candidate source</dt><dd><?= $escaped($status['current_query_name'] ?? $effective['candidate_source']['query_name'] ?? 'Unknown') ?></dd>
		<dt>Query fingerprint</dt><dd><code><?= $escaped($status['current_query_fingerprint'] ?? $effective['query_fingerprint'] ?? '') ?: 'Unavailable' ?></code></dd>
		<dt>Last export attempt / success</dt><dd><?= $formatTime($export['last_export_attempt'] ?? 0) ?> / <?= $formatTime($export['last_export_success'] ?? 0) ?></dd>
		<dt>Active generation</dt><dd><?= (int)$pipeline['active_generation'] ?> (<?= (int)$status['candidate_count'] ?> candidates)</dd>
		<dt>Last worker attempt / success</dt><dd><?= $formatTime($worker['last_attempted_run'] ?? 0) ?> / <?= $formatTime($worker['last_successful_run'] ?? 0) ?></dd>
		<dt>Embeddings</dt><dd><?= (int)$status['current_embeddings'] ?> current, <?= (int)$status['pending_embeddings'] ?> pending</dd>
		<dt>Last label synchronization attempt / success</dt><dd><?= $formatTime($labelSync['last_attempt'] ?? 0) ?> / <?= $formatTime($labelSync['last_success'] ?? 0) ?></dd>
		<dt>Model</dt><dd><?= $escaped($effective['embedding_model'] ?? '') ?></dd>
		<dt>Window / threshold</dt><dd><?= (int)($effective['window_hours'] ?? 0) ?> hours / <?= $escaped($effective['similarity_threshold'] ?? '') ?></dd>
		<dt>Pending work</dt><dd><?= !empty($status['export_pending']) ? 'export ' : '' ?><?= (int)$status['pending_embeddings'] > 0 ? 'embedding ' : '' ?><?= !empty($status['grouping_pending']) ? 'regrouping ' : '' ?><?= !empty($status['label_sync_pending']) ? 'label synchronization' : '' ?><?= empty($status['export_pending']) && (int)$status['pending_embeddings'] === 0 && empty($status['grouping_pending']) && empty($status['label_sync_pending']) ? 'None' : '' ?></dd>
		<dt>Latest error</dt><dd><?= $escaped($latestError) ?: 'None' ?></dd>
	</dl>
<?php endif; ?>

<?php if (FreshRSS_Auth::hasAccess('admin')): ?>
	<form action="<?= _url('extension', 'configure', 'e', urlencode($this->getName())) ?>" method="post">
		<input type="hidden" name="_csrf" value="<?= FreshRSS_Auth::csrfToken() ?>" />
