			<select id="candidate-source" name="candidate_source" required="required">
				<option value="">Choose a saved query</option>
				<option value="all_entries"<?= $selectedSource === 'all_entries' ? ' selected="selected"' : '' ?>>All entries (explicitly unfiltered)</option>
				<?php foreach ($this->savedQueries as $id => $name): ?>
					<option value="<?= $id ?>"<?= $selectedSource === (string)$id ? ' selected="selected"' : '' ?>><?= $escaped($name) ?></option>
				<?php endforeach; ?>
			</select>
