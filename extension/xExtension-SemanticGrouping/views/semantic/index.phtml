<?php
declare(strict_types=1);
/** @var FreshRSS_View $this */
$escaped = static fn(mixed $value): string => htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
$result = $this->semanticGroups;
$status = $this->semanticStatus;
$this->partial('aside_feed');
?>
<main class="post semantic-page">
	<header class="semantic-page-header">
		<h1>Semantic Groups</h1>
		<a class="btn" href="<?= _url('semantic', 'index', 'page', (int)$result['page']) ?>">Refresh</a>
	</header>
	<?php if ($this->semanticError !== ''): ?>
		<p class="alert alert-warn"><?= $escaped($this->semanticError) ?></p>
	<?php elseif (empty($status['configured'])): ?>
		<p class="alert alert-warn">No complete semantic candidate generation is available yet.</p>
	<?php else: ?>
		<p class="help">
			Generation <?= (int)$status['pipeline']['active_generation'] ?>,
			<?= (int)$status['candidate_count'] ?> candidates,
			<?= (int)$status['pending_embeddings'] ?> pending embeddings.
			<?= !empty($status['grouping_pending']) ? 'The displayed groups are from the last complete worker publication.' : '' ?>
		</p>
	<?php endif; ?>

	<?php if ($result['groups'] === []): ?>
		<p>No semantic groups are currently available.</p>
	<?php endif; ?>
	<?php $previousDate = ''; ?>
	<?php foreach ($result['groups'] as $group): ?>
		<?php
		$latestDate = (int)($group['latest_date'] ?? 0);
		$dateKey = $latestDate > 0 ? date('Y-m-d', $latestDate) : '';
		?>
		<?php if ($dateKey !== '' && $dateKey !== $previousDate): ?>
			<h2 class="semantic-date-separator"><time datetime="<?= $dateKey ?>"><?= $escaped(date('F j, Y', $latestDate)) ?></time></h2>
			<?php $previousDate = $dateKey; ?>
		<?php endif; ?>
		<?php $showMemberRoles = count($group['members']) > 1; ?>
		<section class="semantic-group">
			<?php foreach ($group['members'] as $member): ?>
				<article class="semantic-member<?= $showMemberRoles && $member['representative'] ? ' semantic-representative' : '' ?>">
					<h2>
						<?php if ($member['url'] !== ''): ?><a href="<?= $escaped($member['url']) ?>" target="_blank" rel="noopener noreferrer"><?php endif; ?>
						<?= $escaped($member['title']) ?>
						<?php if ($member['url'] !== ''): ?></a><?php endif; ?>
					</h2>
					<p class="semantic-meta">
						<?php if ($showMemberRoles): ?><?= $member['representative'] ? 'Representative' : 'Member' ?> · <?php endif; ?><?= $escaped($member['date']) ?>
						<?php if (!$member['representative'] && $member['similarity'] !== null): ?> · similarity <?= number_format((float)$member['similarity'], 3) ?><?php endif; ?>
						<?= $member['is_read'] ? ' · read' : ' · unread' ?><?= $member['is_favorite'] ? ' · favourite' : '' ?>
					</p>
					<?php if ($member['excerpt'] !== ''): ?><p><?= $escaped($member['excerpt']) ?></p><?php endif; ?>
				</article>
			<?php endforeach; ?>
		</section>
	<?php endforeach; ?>

	<?php if ((int)$result['pages'] > 1): ?>
		<nav class="semantic-pagination" aria-label="Semantic groups pages">
			<?php if ((int)$result['page'] > 1): ?><a class="btn" href="<?= _url('semantic', 'index', 'page', (int)$result['page'] - 1) ?>">Previous</a><?php endif; ?>
			<span>Page <?= (int)$result['page'] ?> of <?= (int)$result['pages'] ?></span>
			<?php if ((int)$result['page'] < (int)$result['pages']): ?><a class="btn" href="<?= _url('semantic', 'index', 'page', (int)$result['page'] + 1) ?>">Next</a><?php endif; ?>
		</nav>
	<?php endif; ?>
</main>
